# Required for the agent, evals and web UI. Never commit a real key.
ANTHROPIC_API_KEY=

# Optional
# AGENT_MODEL=claude-sonnet-5-5        # or haiku / claude-haiku-5-5 (cheap, used for dev)
# AGENT_PROMPT_VERSION=v1               # v1 | v2
# TRACE_DIR=traces                      # CLI: write one JSON trace per run
# STATBANK_MODE=live                    # live | record | replay (offline, uses fixtures)
# STATBANK_FIXTURES_DIR=packages/mcp-server/fixtures
# STATBANK_TIMEOUT_MS=20000
# WEB_RATE_LIMIT=5                      # web UI: questions per IP per 10 minutes
